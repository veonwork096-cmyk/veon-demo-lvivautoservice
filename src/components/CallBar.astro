---
import Icon from "./Icon.astro";
import { contacts } from "../data/site";
// Phone and tablet: bottom bar «Подзвонити / Маршрут» instead of a floating round button (R-012, I-002).
// Without JS it is always shown; with JS it slides in once the hero field leaves the screen.
---
<div class="callbar" data-callbar data-rec="R-012">
  <a class="callbar-btn callbar-btn--call" href={contacts.phoneHref}><Icon name="phone" size={20} />Подзвонити</a>
  <a class="callbar-btn callbar-btn--route" href={contacts.mapHref} target="_blank" rel="noopener"><Icon name="route" size={20} />Маршрут</a>
</div>

<style>
  .callbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-bar);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-bg);
    transition: transform 280ms var(--ease-out);
  }
  :global(.js) .callbar:not(.is-shown) { transform: translateY(100%); }
  .callbar-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs);
    min-height: var(--control-h); font-family: var(--font-display); font-weight: 700; text-decoration: none; white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .callbar-btn:active { background: var(--color-concrete); }
  .callbar-btn:focus-visible { outline-offset: -4px; }
  .callbar-btn--call { background: var(--color-accent); color: var(--color-accent-ink); }
  .callbar-btn--call:active { background: var(--color-accent-hover); }
  .callbar-btn--route { background: var(--color-bg); color: var(--color-text); box-shadow: inset 0 0 0 var(--rule-strong) var(--color-text); }
  @media (min-width: 1024px) {
    .callbar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .callbar, :global(.js) .callbar:not(.is-shown) { transition: none; }
  }
</style>
