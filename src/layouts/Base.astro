---
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/cyrillic-500.css";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} data-rec="R-102" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={`${base}fonts/FixelDisplay-Bold.woff2`} as="font" type="font/woff2" crossorigin data-rec="R-203" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="R-204,R-205,R-206"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  /* Floor 4: no horizontal scroll at any width (also in global.css; repeated here so the layout carries it). */
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
